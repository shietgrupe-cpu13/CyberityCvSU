<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Cyberity.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cyberity_background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_dark</item>
        <item name="postSplashScreenTheme">@style/Theme.MyFirstTry</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Theme.Cyberity.Starting.Light">
        <item name="windowSplashScreenBackground">@color/cyberity_background_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_light</item>
        <item name="postSplashScreenTheme">@style/Theme.MyFirstTry.Light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.Cyberity.Starting.System">
        <item name="windowSplashScreenBackground">@color/cyberity_background_system</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_dark</item>
        <item name="android:windowLightStatusBar">@bool/cyberity_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/cyberity_light_system_bars</item>
    </style>
</resources>
